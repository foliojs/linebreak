{
  "name": "linebreak",
  "version": "1.1.0",
  "description": "An implementation of the Unicode Line Breaking Algorithm (UAX #14)",
  "source": "src/main.ts",
  "type": "module",
  "main": "dist/main.cjs",
  "module": "dist/module.mjs",
  "exports": {
    "import": {
      "types": "./dist/types.d.ts",
      "default": "./dist/module.mjs"
    },
    "require": {
      "types": "./dist/types.d.ts",
      "default": "./dist/main.cjs"
    }
  },
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devongovett/linebreaker.git"
  },
  "keywords": [
    "unicode",
    "text",
    "wrapping"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/devongovett/linebreaker/issues"
  },
  "homepage": "https://github.com/devongovett/linebreaker",
  "dependencies": {
    "unicode-trie": "^2.0.0"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.13.3",
    "@parcel/transformer-typescript-types": "^2.13.3",
    "mocha": "^10.0.0",
    "parcel": "^2.13.3",
    "request": "^2.88.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "test": "parcel build && mocha test/index.js test/iter.js --reporter landing",
    "build": "parcel build",
    "prepublishOnly": "parcel build"
  },
  "targets": {
    "main": {
      "includeNodeModules": [
        "fs"
      ]
    },
    "module": {
      "includeNodeModules": [
        "fs"
      ]
    }
  }
}
